---
import bolha1 from "../assets/ilustracoes/bolhas/1.png";
import bolha2 from "../assets/ilustracoes/bolhas/2.png";
import FloatingBubbles from "../components/ui/FloatingBubbles";
import Marquee from "../components/ui/Marquee.jsx";
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "Nara Oliveira | Designer e Ilustradora";
---

<BaseLayout title={pageTitle}>
  <main class="bg-paper min-h-screen">
    <div class="relative w-full flex items-center justify-center bg-paper overflow-hidden">
      <FloatingBubbles client:load bubbles={[bolha1.src, bolha2.src]} />
      <img
        src="src/assets/ilustracoes/1.png"
        alt="Imagem de destaque"
        class="w-full max-w-7xl h-9/12 object-cover relative z-10 pointer-events-none"
      />
    </div>
    
    <Marquee client:load />

    <section class="container mx-auto px-4 py-20">
      <h2 class="sr-only">Projetos Selecionados</h2>
      <div
        class="h-64 border-2 border-dashed border-ink/20 flex items-center justify-center text-ink/40"
      >
        [Área da Grid de Projetos]
      </div>
    </section>
  </main>
</BaseLayout>
