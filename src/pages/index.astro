---
import ilustracao1 from "../assets/ilustracoes/1.png";
import ilustracao3 from "../assets/ilustracoes/3.png";
import ilustracao4 from "../assets/ilustracoes/4.png";
import bolha1 from "../assets/ilustracoes/bolhas/1.png";
import bolha2 from "../assets/ilustracoes/bolhas/2.png";
import FloatingBubbles from "../components/ui/FloatingBubbles";
import Marquee from "../components/ui/Marquee.jsx";
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "Nara Oliveira | Designer, Designer Editorial e Ilustradora";
---

<BaseLayout title={pageTitle}>
  <main class="bg-paper min-h-screen">
    <section class="h-[calc(100dvh-5rem)] min-h-125 flex flex-col justify-between overflow-hidden">
      <div class="relative w-full flex-1 min-h-0 flex items-center justify-center px-4 md:px-8 overflow-hidden">
        <FloatingBubbles client:load bubbles={[bolha1.src, bolha2.src]} />
        <img
          src={ilustracao1.src}
          alt="Imagem de destaque"
          class="hero-breathe max-h-full max-w-full w-auto h-auto object-contain relative z-10 pointer-events-none select-none py-2"
        />
      </div>
      
      <div class="w-full shrink-0">
        <Marquee client:load />
      </div>
    </section>

    <section class="reveal-stagger">
      <img
        src={ilustracao3.src}
        alt="Imagem de segundo destaque"
        class="reveal max-h-full max-w-full w-auto h-auto object-contain relative z-10 pointer-events-none select-none pb-2"
      />
      <p class="reveal text-center text-ink/80 text-md mt-4">
        dou cor, forma e vida a livros infantojuvenis
      </p>
      <p class="reveal text-center text-ink/80 text-md">
        pensando no tempo que tenho para pensar sobre o tempo que falta
      </p>
    </section>

    <section class="reveal container mx-auto px-4 py-20">
      <h2 class="sr-only">Projetos Selecionados</h2>
      <div
        class="h-64 border-2 border-dashed border-ink/20 flex items-center justify-center text-ink/40"
      >
        [Área da Grid de Projetos]
      </div>
    </section>

    <section class="reveal relative overflow-hidden">
      <div class="max-w-7xl mx-auto px-2 md:px-6 py-12 md:py-20 lg:py-26">
        <div class="grid grid-cols-1 lg:grid-cols-[1fr_auto] gap-16 items-end">

          <div class="space-y-8 md:space-y-10 reveal-stagger">
            <span class="reveal text-xs font-semibold uppercase tracking-[0.2em] text-accent block">
              Vamos criar juntos
            </span>

            <div class="reveal">
              <h2 class="font-display text-4xl sm:text-5xl md:text-6xl lg:text-7xl xl:text-8xl leading-[0.95] tracking-tight text-ink">
                tem um projeto <br class="hidden sm:block" />
                <span class="italic text-ink/70">em mente</span>?
              </h2>
            </div>

            <p class="reveal text-base md:text-lg text-ink/60 max-w-lg leading-relaxed">
              Estou sempre aberta a novas histórias — livros infantojuvenis, 
              projetos editoriais, colaborações criativas ou apenas um bom café virtual.
            </p>

            <div class="reveal group">
              <a
                href="mailto:oli.studiodsng@gmail.com"
                class="inline-flex items-center gap-3 md:gap-4 text-lg md:text-xl font-display font-medium text-ink border-b-2 border-ink/20 pb-2 hover:border-accent hover:text-accent transition-all duration-500 ease-out"
              >
                <span>oli.studiodsng@gmail.com</span>
                <svg 
                  class="w-5 h-5 md:w-6 md:h-6 translate-x-0 group-hover:translate-x-1.5 transition-transform duration-500 ease-out" 
                  fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12h15m0 0l-6.75-6.75M19.5 12l-6.75 6.75" />
                </svg>
              </a>
            </div>

            <div class="reveal flex flex-wrap items-center gap-x-6 gap-y-3 pt-2">
              <a
                href="https://www.instagram.com/naraoliveiraz/"
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm tracking-wide text-ink/45 hover:text-accent transition-colors duration-300"
              >
                Instagram
              </a>
              <span class="text-ink/15 select-none" aria-hidden="true">·</span>
              <a
                href="https://www.behance.net/naraoliveiraz"
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm tracking-wide text-ink/45 hover:text-accent transition-colors duration-300"
              >
                Behance
              </a>
              <span class="text-ink/15 select-none" aria-hidden="true">·</span>
              <a
                href="https://br.linkedin.com/in/naraoliveiraz"
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm tracking-wide text-ink/45 hover:text-accent transition-colors duration-300"
              >
                LinkedIn
              </a>
            </div>
          </div>

          <div class="flex items-end justify-end select-none pointer-events-none">
            <img
              src={ilustracao4.src}
              alt="Ilustração de um vaso com planta"
              class="w-48 xl:w-56 h-auto object-contain opacity-80"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>
