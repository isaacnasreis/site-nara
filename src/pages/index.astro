---
import ilustracao1 from "../assets/ilustracoes/1.png";
import ilustracao3 from "../assets/ilustracoes/3.png";
import bolha1 from "../assets/ilustracoes/bolhas/1.png";
import bolha2 from "../assets/ilustracoes/bolhas/2.png";
import Contato from "../components/contato/Contato.astro";
import FloatingBubbles from "../components/ui/FloatingBubbles";
import Marquee from "../components/ui/Marquee.jsx";
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "Nara Oliveira | Designer, Designer Editorial e Ilustradora";
---

<BaseLayout title={pageTitle}>
  <main class="bg-paper min-h-screen">
    <section class="h-[calc(100dvh-5rem)] min-h-125 flex flex-col justify-between overflow-hidden">
      <div class="relative w-full flex-1 min-h-0 flex items-center justify-center px-4 md:px-8 overflow-hidden">
        <FloatingBubbles client:load bubbles={[bolha1.src, bolha2.src]} />
        <img
          src={ilustracao1.src}
          alt="Imagem de destaque"
          class="hero-breathe max-h-full max-w-full w-auto h-auto object-contain relative z-10 pointer-events-none select-none py-2"
        />
      </div>
      
      <div class="w-full shrink-0">
        <Marquee client:load />
      </div>
    </section>

    <section class="reveal-stagger">
      <img
        src={ilustracao3.src}
        alt="Imagem de segundo destaque"
        class="reveal max-h-full w-full h-auto object-contain relative z-10 pointer-events-none select-none pb-2"
      />
      <p class="reveal text-center text-ink/80 text-md mt-4">
        dou cor, forma e vida a livros infantojuvenis
      </p>
      <p class="reveal text-center text-ink/80 text-md">
        pensando no tempo que tenho para pensar sobre o tempo que falta
      </p>
    </section>

    <!-- <section class="reveal container mx-auto px-4 py-20">
      <h2 class="sr-only">Projetos Selecionados</h2>
      <div
        class="h-64 border-2 border-dashed border-ink/20 flex items-center justify-center text-ink/40"
      >
        [Área da Grid de Projetos]
      </div>
    </section> -->

    <Contato />

  </main>
</BaseLayout>
