---
import { ClientRouter } from "astro:transitions";
import ilustracao2 from "../assets/ilustracoes/2.png";
import Header from "../components/layout/Header.astro";
import "../styles/global.css";

const {
  title,
  description = "Portfólio de Nara Oliveira, Designer, Designer Editorial e Ilustradora.",
} = Astro.props;
---

<html lang="pt-br">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />

    <meta name="description" content={description} />
    <title>{title}</title>

    <ClientRouter />
  </head>
  <body
    class="bg-paper text-ink font-sans antialiased selection:bg-accent selection:text-white"
  >
    <Header />

    <slot />

    <footer
      class="py-10 text-center text-xs opacity-40 uppercase tracking-widest"
    >
      <img 
        src={ilustracao2.src} 
        alt="Ícone Oli Studio"
        class="w-20 h-20 mx-auto mb-2 transition-all duration-700 ease-out group-hover:rotate-12 group-hover:scale-110"
        loading="eager" 
      />
      © {new Date().getFullYear()} Nara Oliveira / Oli Studio
    </footer>
  </body>
</html>
